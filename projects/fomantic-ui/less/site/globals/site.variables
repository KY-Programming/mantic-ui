/*******************************
     User Global Variables
*******************************/

// The flag sprite is loaded from the app: the theme assets are copied to /assets/ of the app (see the README)
@imagePath: "/assets/themes/default/assets/images";
// Only used by the Lato and icon fonts, which go to m-fomantic-ui-lato-local and m-fomantic-ui-icons-local: relative to
// those components, so ng-packagr inlines them
@fontPath: "../../../assets/themes/default/assets/fonts";
